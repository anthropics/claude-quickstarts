# Anthropic auth, either of:
#   - an API key from https://platform.claude.com/ (uncomment and fill in)
#   - nothing at all for the stdio path, after signing in once with
#     `ant auth login` (the ant CLI and the SDK share those credentials).
#     A deployed HTTP server has no login to share, so it needs the key.
# ANTHROPIC_API_KEY=sk-ant-...

# One environment shared by every session this server creates. Create it from
# environment.yaml (the command is in that file) and it lands here.
# CLAUDE_ENVIRONMENT_ID=

# Comma-separated agent IDs this server may touch. Unset, every agent in the
# workspace your credentials belong to is reachable: listed, read, and run.
# Set it before you put the HTTP server on a network.
# ALLOWED_AGENT_IDS=agent_...,agent_...

# --- HTTP transport only (bun run http) -------------------------------------

# Bearer token the client must send. At least 32 characters, or the server
# refuses to start. Generate: openssl rand -hex 32
MANAGED_AGENTS_MCP_TOKEN=

PORT=3000

# Bind address. Loopback by default. Set 0.0.0.0 only behind TLS, and then
# ALLOWED_HOSTS is required.
# HOST=127.0.0.1

# Hostnames (host or host:port) clients will put in the Host header. Defaults
# to the loopback names on PORT. Required when HOST is not loopback.
# ALLOWED_HOSTS=agents.example.com

# Browser origins allowed to call the server. Leave unset unless a browser app
# is the MCP client. Server-to-server clients send no Origin header.
# ALLOWED_ORIGINS=https://app.example.com
