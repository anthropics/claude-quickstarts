# This app supports either Claude (Anthropic) or Gemini (Google) — set one
# or both keys below. AI_PROVIDER picks explicitly ("anthropic" or "gemini");
# leave it unset to auto-select: Anthropic if ANTHROPIC_API_KEY is set,
# otherwise Gemini if GEMINI_API_KEY is set.

# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model used for the coordinator (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: force a provider instead of auto-selecting ("anthropic" | "gemini")
AI_PROVIDER=
