# Anthropic auth, either of:
#   - an API key from https://platform.claude.com/ (uncomment and fill in)
#   - nothing at all, after signing in once with `ant auth login`
#     (the ant CLI and the SDK share those credentials)
# ANTHROPIC_API_KEY=sk-ant-...

# The repository the fixer works on: the one whose errors land in Sentry.
GITHUB_REPO_URL=https://github.com/you/sentry-autofix-demo
# Pull requests target this branch. It must be protected (direct pushes
# blocked), or the server refuses to start: see the README, "The pull request
# is the checkpoint".
GITHUB_BASE_BRANCH=main
# A fine-grained personal access token scoped to that one repository, with
# Contents: read and write, and Pull requests: read and write. It clones and
# pushes through a proxy outside the sandbox and opens pull requests from
# this server. It never enters a session.
GITHUB_TOKEN=

# The Client Secret of your Sentry internal integration (Settings > Developer
# Settings > your integration). Sentry signs every webhook with it.
SENTRY_CLIENT_SECRET=
# Only fix issues from this Sentry project slug. Leave empty to accept every
# project the integration can see.
SENTRY_PROJECT=

# Hard spend cap per fix session, in US dollars at list prices. A session
# that reaches it pauses instead of continuing.
AUTOFIX_MAX_USD=10
# How many fixes this process runs at once. Issues that arrive beyond it are
# logged and skipped, so a burst of new issues cannot spend this many times
# the cap above.
AUTOFIX_MAX_ACTIVE=3

# Where the server listens. The default bind is loopback-only; point a tunnel
# at it for Sentry's webhooks rather than binding 0.0.0.0.
PORT=3000
# HOST=127.0.0.1

# ./agents/setup.sh appends CLAUDE_VAULT_ID below. The agent and environment
# IDs are not here: `ant apply` records them in claude-lock.json.
