# Set these with `vercel env add <NAME>`. This file is only a checklist, and
# `vercel dev` reads a local copy of it (.env.local).

# Issued by Anthropic when you register the webhook (starts with whsec_)
ANTHROPIC_WEBHOOK_SECRET=

# The env_... ID in ../webhook-demo/claude-lock.json, written by `ant apply .` there
ANTHROPIC_ENVIRONMENT_ID=

# The environment key for that environment, minted in the Console. It stays in
# the function: sandboxes get a per-session token instead.
ANTHROPIC_ENVIRONMENT_KEY=

# Optional. Defaults to https://api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Optional. Only when every session in this environment trusts every other:
# lets a work item that carries no per-session secret run with the environment
# key inside the sandbox, where the agent's bash can read it.
# ALLOW_ENVIRONMENT_KEY_IN_SANDBOX=true
