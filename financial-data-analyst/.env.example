# Anthropic API key — used by the server to call Claude. Never commit a real key.
ANTHROPIC_API_KEY=your_api_key_here

# Shared secret that protects POST /api/finance.
# The route refuses every request if this is unset, and refuses requests that
# do not send: Authorization: Bearer <same value>
# Pick any long random string. Use the SAME value for NEXT_PUBLIC_API_SECRET
# so the browser UI can send the header.
API_SECRET=replace-me-with-a-long-random-string

# Same value as API_SECRET. Next.js only exposes NEXT_PUBLIC_* vars to the
# browser, so the UI needs this copy to attach the Authorization header.
# Anyone who can load the page can also read this value — this is a simple
# shared-secret gate, not a full login system.
NEXT_PUBLIC_API_SECRET=replace-me-with-a-long-random-string
